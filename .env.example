# Environment Configuration Template
# DO NOT PUT REAL SECRETS IN THIS FILE (.env.example is public)
# Copy this file to .env and fill in your private values:
#   cp .env.example .env

# The Odds API Key (Get a free API key at https://the-odds-api.com)
ODDS_API_KEY=your_the_odds_api_key_here

# App Environment (development, production)
ENVIRONMENT=production

# Server Configuration
PORT=8050
HOST=0.0.0.0

# Security: Allowed CORS Origins (comma-separated URLs)
# In production, set this to your deployment domain (e.g., https://my-nba-app.onrender.com)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8050,http://127.0.0.1:8050

# Security: Secret Key for session/signing (generate random string)
SECRET_KEY=change_this_to_a_random_32_character_secret_string

